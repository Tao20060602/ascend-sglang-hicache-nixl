# 版本锚点(B 臂:SGLang 主线 + HiCache + NIXL posix)
# 本文件是所有脚本的唯一版本来源;改版本只改这里,并在报告里记录变更。
# 依据:SGLang 官方 Ascend 安装文档的 CANN 9.1.0 套件(A3 系列),装前按文档复核。

# SGLang:主线源码安装(昇腾侧唯一官方路径);建议固定 release tag 并把值记录进报告
SGLANG_REF=main

# CANN 9.1.0 套件组件(与 sglang Ascend 文档版本表一致;若容器 CANN 是 9.0.0,
# 先查文档中 CANN 9.0.0 对应行并同步修改下面三个值,不要跨套件混用)
PY_VER=3.12
TORCH_VERSION=2.10.0
TORCHVISION_VERSION=0.25.0
TORCH_NPU_VERSION=2.10.0.post6

# 由 pyproject_npu.toml 的 all_npu extra 拉取,列出仅作核对基准
# sgl-kernel-npu==2026.9.0.post9  triton-ascend==3.2.2

# NIXL:留空 = pip 安装最新发布版;填 tag 名 = 源码构建
NIXL_REF=

# 冒烟模型(ModelScope 仓 ID)
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
MODEL_DIR_NAME=qwen2.5-0.5b
